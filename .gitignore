node_modules/

# Build output
dist/

# 생성 산출물(SBOM 등)은 저장소에 남기지 않는다.
# 신규 앱 스캐폴딩 시 워킹트리를 통째로 복사하면서 남의 앱 SBOM이 커밋된 사고가 있었다.
client/artifacts/

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db


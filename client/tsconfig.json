{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // src/seo/*가 scripts/prerender-*.mjs를 그대로 import한다 — 정적 HTML과 화면이
    // 같은 문구를 쓰게 하는 유일한 방법이고, 그러려면 .mjs 해석이 켜져 있어야 한다.
    // checkJs는 끈 채로 둔다(빌드 스크립트를 타입 검사 대상으로 만들지 않는다).
    "allowJs": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["dist", "node_modules"]
}
